# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public origin, no trailing slash. REQUIRED for production builds: it drives
# metadataBase, robots.txt, sitemap.xml and the sign-in email redirect. On
# Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL, but set it explicitly
# for a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# The publishable key is intentionally browser-visible. It is protected by
# column grants and row level security, not by secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google sign-in. Set to 1 ONLY after both steps are done, or the button
# renders and then fails with "provider is not enabled":
#   1. Google Cloud -> Credentials -> OAuth client ID (Web application).
#      Authorised redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
#   2. Supabase -> Authentication -> Providers -> Google -> paste the client
#      ID and secret, enable.
# Anything other than 1 hides the button; email sign-in is unaffected.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=0

# Server-only. Bypasses row level security entirely. Used by exactly one file:
# the Razorpay webhook, which arrives with no user session. Must never be
# prefixed NEXT_PUBLIC_ and must never be imported into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# Without these, transactional email becomes a logged no-op and the app still
# runs. Notification emails never contain vendor contact details.
RESEND_API_KEY=
EMAIL_FROM="Wedding Vendor <hello@yourdomain.example>"
EMAIL_REPLY_TO=support@yourdomain.example

# ---------------------------------------------------------------------------
# Payments (Razorpay)
# ---------------------------------------------------------------------------
# Key id is sent to the browser to open Checkout. The secret and the webhook
# secret are server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
