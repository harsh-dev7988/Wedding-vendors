{
  "name": "wedding-vendor-marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:test": "npx --yes supabase test db",
    "db:reset": "npx --yes supabase db reset",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:bundle": "node scripts/bundle-migrations.mjs",
    "db:apply": "node scripts/db-apply.mjs",
    "db:verify": "node scripts/db-verify.mjs",
    "db:make-admin": "node scripts/db-make-admin.mjs",
    "media:backfill": "node scripts/media-backfill.mjs",
    "email:test": "node scripts/email-test.mjs",
    "audit:layout": "node scripts/layout-audit.mjs",
    "db:notifications-test": "node scripts/db-notifications-test.mjs",
    "db:grants": "node scripts/db-grant-audit.mjs",
    "db:pincodes": "node scripts/import-pincodes.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "resend": "^6.22.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.2",
    "pg": "^8.23.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
