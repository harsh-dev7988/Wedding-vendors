# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Internal documentation — audits, gap analysis and change history.
# These describe known weaknesses and unbuilt areas in detail, which is a
# roadmap for anyone probing the deployment. Kept local deliberately.
/docs/
/IMPLEMENTATION_LOG.md
CLAUDE.md

# Source datasets. The pincode export is 23 MB and is loaded into Postgres by
# scripts/import-pincodes.mjs; the repository does not need a second copy.
*.csv
